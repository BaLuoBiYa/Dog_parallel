<robot name="dog_single_leg">
  <!--
    最简四连杆腿（无 collision，无 inertial）
    树状结构（保留关节命名）：
      parent
        ├─ Front ─ Front_Upper ─ Front_Passive ─ Front_Lower ─ Front_Connect ─ Tip
        └─ Back  ─ Back_Upper  ─ Back_Passive  ─ Back_Lower  ─ Back_Connect
    说明：
      - Tip 为足端（仅链接定义）
      - Front_Connect / Back_Connect 为闭环切断的虚拟端点（仅链接/固定关节）
      - 不包含 <collision> 与 <inertial>
  -->
  <!-- 简单基座 -->
  <link name="base_link"/>
  <!-- 固定到父节点 -->
  <joint name="LF_Mount" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="LF_Mount_Link"/>
  </joint>
  <link name="LF_Mount_Link"/>
  <!-- 前侧驱动 -->
  <joint name="LF_Front" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="LF_Mount_Link"/>
    <child link="LF_Front_Upper"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="10"/>
  </joint>
  <link name="LF_Front_Upper"/>
  <joint name="LF_Front_Passive" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.13583"/>
    <parent link="LF_Front_Upper"/>
    <child link="LF_Front_Lower"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="10"/>
  </joint>
  <link name="LF_Front_Lower"/>
  <!-- 前端虚拟连接到足端 -->
  <joint name="LF_Front_Connect" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.18533"/>
    <parent link="LF_Front_Lower"/>
    <child link="LF_Tip"/>
  </joint>
  <link name="LF_Tip"/>
  <!-- 后侧驱动 -->
  <joint name="LF_Back" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="LF_Mount_Link"/>
    <child link="LF_Back_Upper"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="10"/>
  </joint>
  <link name="LF_Back_Upper"/>
  <joint name="LF_Back_Passive" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.13583"/>
    <parent link="LF_Back_Upper"/>
    <child link="LF_Back_Lower"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="-3.14159" upper="3.14159" velocity="10"/>
  </joint>
  <link name="LF_Back_Lower"/>
  <!-- 后端虚拟端点（闭环切断） -->
  <joint name="LF_Back_Connect" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.18533"/>
    <parent link="LF_Back_Lower"/>
    <child link="LF_Back_Connect_Link"/>
  </joint>
  <link name="LF_Back_Connect_Link"/>
  <!-- 注意：Front_Connect 与 Back_Connect 在理想闭环下应重合，由上层运动学/控制保证 -->
  <!-- 关节电机简化宏 -->
  <!-- ros2_control 最小声明 -->
  <ros2_control name="go8010" type="system">
    <hardware>
      <param name="configPath">
                /home/luo/Project/Horse/Dog_parallel/src/dog_bringup/parameters/motors.yaml</param>
      <plugin>dog8Dof/singleBaseHardware</plugin>
    </hardware>
    <joint name="LF_Front">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="LF_Rear">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
