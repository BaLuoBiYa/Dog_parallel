<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="parallel_leg_4bar"
        params="
        prefix
        parent:=base
        upper_len
        lower_len
        link_radius:=0.012
        foot_radius:=0.020
        motor_lower:=-1.57
        motor_upper:=1.57
        effort_limit:=55
        velocity_limit:=100
        passive_lower:=-3.1415926
        passive_upper:=3.1415926
        *origin">

        <!--
            树状展开后的结构：
            parent
              ├─ Front ─ Front_Upper ─ Front_Passive ─ Front_Lower ─ Front_Connect ─ Tip
              └─ Back ─ Back_Upper ─ Back_Passive ─ Back_Lower ─ Back_Connect

            说明：
            1. Tip 是真实足端，可保留碰撞。
            2. Front_Connect 与 Back_Connect 是闭环切断后的虚拟端点，默认不加 collision。
            3. 理想闭环下，Front_Connect 与 Front_Connect 应由运动学/约束保持重合。
        -->

        <xacro:property name="upper_ixx"
            value="${upper_mass * (3.0*link_radius*link_radius + upper_len*upper_len) / 12.0}" />
        <xacro:property name="upper_izz" value="${0.5 * upper_mass * link_radius * link_radius}" />

        <xacro:property name="lower_ixx"
            value="${lower_mass * (3.0*link_radius*link_radius + lower_len*lower_len) / 12.0}" />
        <xacro:property name="lower_izz" value="${0.5 * lower_mass * link_radius * link_radius}" />

        <xacro:property name="foot_i" value="${(2.0 * foot_mass * foot_radius * foot_radius) / 5.0}" />
        <xacro:property name="dummy_i" value="1e-8" />

        <!-- 固定点 -->
        <joint name="${prefix}_Mount" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}_Mount_Link" />
        </joint>

        <link name="${prefix}_Mount_Link" />


        <!-- 前侧驱动电机 -->
        <joint name="${prefix}_Front" type="revolute">
            <origin rpy="0 0 0" xyz="0 0 0" />
            <parent link="${prefix}_Mount_Link" />
            <child link="${prefix}_Front_Upper" />
            <axis xyz="1 0 0" />
            <dynamics damping="${damping}" friction="${friction}" />
            <limit effort="${effort_limit}" velocity="${velocity_limit}"
                lower="${motor_lower}" upper="${motor_upper}" />
        </joint>

        <!-- 前上侧连杆 -->
        <link name="${prefix}_Front_Upper">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 -${upper_len / 2}" />
                <geometry>
                    <cylinder length="${upper_len}" radius="${link_radius}" />
                </geometry>
                <material name="orange" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 -${upper_len / 2}" />
                <geometry>
                    <cylinder length="${upper_len}" radius="${link_radius}" />
                </geometry>
            </collision>
        </link>

        <!-- 前方中间被动关节 -->
        <joint name="${prefix}_Front_Passive" type="revolute">
            <origin rpy="0 0 0" xyz="0 0 -${upper_len}" />
            <parent link="${prefix}_Front_Upper" />
            <child link="${prefix}_Front_Lower" />
            <axis xyz="1 0 0" />
            <dynamics damping="0" friction="0" />
            <limit effort="${effort_limit}" velocity="${velocity_limit}"
                lower="${passive_lower}" upper="${passive_upper}" />
        </joint>

        <!-- 前下侧连杆 -->
        <link name="${prefix}_Front_Lower">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 -${lower_len / 2}" />
                <geometry>
                    <cylinder length="${lower_len}" radius="${link_radius}" />
                </geometry>
                <material name="green" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 -${lower_len / 2}" />
                <geometry>
                    <cylinder length="${lower_len}" radius="${link_radius}" />
                </geometry>
            </collision>
        </link>

        <!-- 前方下连接点 -->
        <joint name="${prefix}_Front_Connect" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 -${lower_len}" />
            <parent link="${prefix}_Front_Lower" />
            <child link="${prefix}_Tip" />
        </joint>

        <!-- 前下侧连杆 -->
        <link name="${prefix}_Tip">
            <visual>
                <origin rpy="0 0 45" xyz="0 0 0" />
                <geometry>
                    <sphere radius="${foot_radius}" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <origin rpy="0 0 45" xyz="0 0 0" />
                <geometry>
                    <sphere radius="${foot_radius}" />
                </geometry>
            </collision>
        </link>

    </xacro:macro>
</robot>